# Copy to .env (never commit .env) and replace every REPLACE_ value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
#                    or:  openssl rand -hex 32

DEBUG=False
SECRET_KEY=REPLACE_SECRET
# Comma-separated. On the server use the exact hostname, e.g. yourname.duckdns.org
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included. On the server: https://yourname.duckdns.org
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Keep False until the HTTPS certificate works, then set True and recreate api.
HTTPS_ENABLED=False

POSTGRES_DB=omniedge
POSTGRES_USER=omniedge
POSTGRES_PASSWORD=REPLACE_PASSWORD
# Same password as above (hex passwords need no URL-encoding). Host is the compose service "db".
DATABASE_URL=postgresql://omniedge:REPLACE_PASSWORD@db:5432/omniedge
# The database runs on the private Docker network without TLS.
DATABASE_SSLMODE=disable

# Private evidence lives on the persistent "evidence" volume mounted at /app/media.
EVIDENCE_ROOT=/app/media/private_evidence

# Gunicorn workers: 2 suits a 1 GB Always Free VM.
GUNICORN_WORKERS=2

# Use the client IP forwarded by the host Nginx for login rate limiting.
ACCOUNT_TRUST_PROXY_IP=true

# Optional SMTP for account email (password reset / verification codes).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
