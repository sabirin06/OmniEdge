SECRET_KEY=replace-with-a-generated-secret
ALLOWED_HOSTS=soc.example.com
DATABASE_URL=postgresql://omniedge:replace-with-url-encoded-password@127.0.0.1:5432/omniedge
DATABASE_SSLMODE=require
CSRF_TRUSTED_ORIGINS=https://soc.example.com
EVIDENCE_ROOT=/var/lib/omniedge/evidence

# Set these to your mail provider's SMTP submission details.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ACCOUNT_TRUST_PROXY_IP=true
