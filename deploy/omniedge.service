[Unit]
Description=OmniEdge API
After=network.target postgresql.service

[Service]
User=omniedge
Group=omniedge
WorkingDirectory=/opt/omniedge/backend
EnvironmentFile=/etc/omniedge.env
Environment=DJANGO_SETTINGS_MODULE=omni_edge.settings.production
ExecStart=/opt/omniedge/.venv/bin/gunicorn --bind 127.0.0.1:8010 --workers 3 --access-logfile - --error-logfile - omni_edge.wsgi:application
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
